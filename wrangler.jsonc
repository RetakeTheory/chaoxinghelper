{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chaoxinghelper",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": true,
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "chaoxinghelper-db", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "r2_buckets": [
    { "binding": "ONEBOT_REMINDERS", "bucket_name": "chaoxinghelper-reminders" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ONEBOT", "class_name": "OneBotSession" },
      { "name": "CHAOXING_WEB", "class_name": "ChaoxingWebSession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OneBotSession", "ChaoxingWebSession"] }
  ],
  "observability": { "enabled": true }
}
